@* Variação contra o mês anterior. Gasto subindo é ruim; entrada subindo é bom. *@

@if (!Previous.IsZero)
{
    var change = (double)(Current.Cents - Previous.Cents) / Previous.Cents;
    var good = LowerIsBetter ? change <= 0 : change >= 0;
    <span class="delta @(good ? "good" : "bad")">
        @(change >= 0 ? "▲" : "▼") @Fmt.Percent(Math.Abs(change)) vs mês anterior
    </span>
}
else
{
    <span class="hint">Sem mês anterior pra comparar</span>
}

@code {
    [Parameter] public Money Current { get; set; }
    [Parameter] public Money Previous { get; set; }
    [Parameter] public bool LowerIsBetter { get; set; }
}
